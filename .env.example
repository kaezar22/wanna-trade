# Copia este archivo como .env.local y llena los valores.
# .env.local está en .gitignore: nunca se sube a GitHub.
# En Vercel, estas mismas variables van en Settings > Environment Variables.

DEEPSEEK_API_KEY=
NEWS_API_KEY=

# Opcional: 1 = precios y tasas simulados, para desarrollar sin conexión.
MARKET_DATA_MOCK=

# Opcional: token de datos.gov.co (más consultas por hora para las tasas de CDT).
SOCRATA_APP_TOKEN=
